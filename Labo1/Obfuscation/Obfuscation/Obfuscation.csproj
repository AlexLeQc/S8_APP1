<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release;AOT</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Obfuscation.Tests" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'AOT'">
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Optimize>true</Optimize>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Obfuscar" Version="3.0.0-beta.20">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="12.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="obfuscar.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_ObfuscarConfig>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)obfuscar.xml'))</_ObfuscarConfig>
    </PropertyGroup>
    <Copy SourceFiles="$(ProjectDir)obfuscar.xml" DestinationFiles="$(_ObfuscarConfig)" />
    <XmlPoke XmlInputPath="$(_ObfuscarConfig)" Query="/Obfuscator/Var[@name='OutPath']/@value" Value="$(TargetDir)obfuscated" />
    <XmlPoke XmlInputPath="$(_ObfuscarConfig)" Query="/Obfuscator/Module/@file" Value="$(TargetPath)" />
    <Exec WorkingDirectory="$(TargetDir)" Command="&quot;$(PkgObfuscar)\tools\Obfuscar.Console.exe&quot; &quot;$(_ObfuscarConfig)&quot;" />
  </Target>

  <Target Name="SanitizeNativeAotToolPaths" AfterTargets="SetupOSSpecificProps" BeforeTargets="LinkNative" Condition="'$(Configuration)' == 'AOT'">
    <PropertyGroup>
      <CppLinker>$([System.Text.RegularExpressions.Regex]::Replace('$(CppLinker)', '^.*;', ''))</CppLinker>
      <CppLibCreator>$([System.Text.RegularExpressions.Regex]::Replace('$(CppLibCreator)', '^.*;', ''))</CppLibCreator>
    </PropertyGroup>
  </Target>

</Project>
